# ============================================================
# photo-puzzle 环境变量样例
# 复制为 .env.local（本地）或写入 Vercel Project Settings（线上）
# ============================================================

# ---------- Supabase（必填）----------
# Supabase 控制台 → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 可暴露给浏览器：只用于公共读取与「预签名上传」，权限由 RLS 约束
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ⚠️ 绝对不能加 NEXT_PUBLIC_ 前缀，也绝不能出现在客户端代码里。
# 只在服务端 runtime 使用：签发 signed URL、写入 unlocks、sharp 处理图片、管理端写入。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 私有 bucket 名称（默认 photos，需与 migration 中一致）
SUPABASE_PHOTOS_BUCKET=photos

# ---------- 会话加密（必填）----------
# 用于签发匿名 session cookie 与管理员 session cookie（jose HS256）。
# 生产环境必须 >= 32 字符随机串，例如：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_PASSWORD=please-generate-a-32+chars-random-secret

# ---------- 管理员（二选一或并存）----------
# 自建密码登录：首次部署时用它完成初始化，成功后即可从环境变量中移除。
# 数据库中只保存 bcrypt 哈希（pgcrypto crypt(..., gen_salt('bf', 12))）。
ADMIN_SETUP_TOKEN=please-set-a-one-time-setup-token

# Supabase Auth 登录（可选）：只有该邮箱的已登录用户被视为管理员。
# 同时需要在 SQL 中把邮箱写进 public.admin_users。
ADMIN_EMAILS=you@example.com

# 站点信息（用于封面与 OG 卡片）
NEXT_PUBLIC_SITE_NAME=照片拼图
NEXT_PUBLIC_HOST_NICKNAME=小杨
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- 可选：限流 ----------
# 进程内限流默认开启；多实例部署建议接 Upstash Redis（此处仅为占位）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
